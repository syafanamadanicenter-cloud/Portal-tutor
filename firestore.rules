rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/tutors/$(request.auth.uid)).data.role == 'admin';
    }

    match /tutors/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /schedules/{id} {
      allow read: if signedIn() && (resource.data.tutorUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /attendance/{id} {
      allow read: if signedIn() && (resource.data.tutorUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /substitutions/{id} {
      allow read: if signedIn() && (resource.data.originalUid == request.auth.uid ||
                                    resource.data.substituteUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /payouts/{id} {
      allow read: if signedIn() && (resource.data.tutorUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
